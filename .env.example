# PostgreSQL — matches the docker-compose.yml service credentials
DATABASE_URL="postgresql://domainapp:domainapp@localhost:5432/domain_knowledge"

# NextAuth / sidebase secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Self-hosted OpenID Connect provider (Keycloak via docker-compose)
OIDC_ISSUER="http://localhost:8080/realms/domain-app"
OIDC_CLIENT_ID="domain-knowledge-app"
OIDC_CLIENT_SECRET="dev-client-secret"
