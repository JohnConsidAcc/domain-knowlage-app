# ── Production environment ────────────────────────────────────────────────────
# Copy this file to .env.prod and fill in real values before deploying.
# Run with: docker compose --env-file .env.prod up -d
# .env.prod is gitignored — never commit it.

# ── Server IP (for TLS certificate) ──────────────────────────────────────────
# The public IP of the server (EC2 Elastic IP). Nginx embeds this as a Subject
# Alternative Name in the self-signed certificate so browsers accept it.
SERVER_IP=YOUR_EC2_PUBLIC_IP

# ── App public URL ────────────────────────────────────────────────────────────
# HTTPS on port 443 (default port, no port suffix needed).
# Used by NextAuth and injected into the Keycloak realm for redirect URIs.
APP_URL=https://YOUR_EC2_PUBLIC_IP

# ── App database (Postgres for Nuxt / Prisma) ────────────────────────────────
POSTGRES_USER=domainapp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=domain_knowledge

# ── Keycloak database (separate Postgres instance for Keycloak) ──────────────
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-strong-password
KC_DB_DATABASE=keycloak

# ── Keycloak admin ────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password

# ── Keycloak external URL ─────────────────────────────────────────────────────
# Keycloak is proxied by Nginx at /auth/ on port 443 (same port as the app).
# --http-relative-path=/auth makes Keycloak serve under /auth/ internally.
# KC_HOSTNAME_URL must include the /auth path so Keycloak builds correct URLs.
KC_HOSTNAME_URL=https://YOUR_EC2_PUBLIC_IP/auth

# ── Realm file ────────────────────────────────────────────────────────────────
KC_REALM_FILE=./keycloak/realm.prod.json

# ── NextAuth ─────────────────────────────────────────────────────────────────
# NEXTAUTH_URL must match APP_URL (HTTPS, no trailing slash).
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=${APP_URL}

# ── OIDC / Keycloak client ────────────────────────────────────────────────────
# OIDC_ISSUER is the external Keycloak URL — used by the browser for sign-out
# and by Keycloak itself to build the issuer claim in JWT tokens.
# The app uses OIDC_INTERNAL_ISSUER (http://keycloak:8080) for all server-side
# OIDC calls so no TLS cert trust is needed.
# Must match the client secret in realm.prod.json (substituted at realm import).
# Generate with: openssl rand -base64 32
OIDC_CLIENT_SECRET=change-me-strong-secret
OIDC_ISSUER=https://YOUR_EC2_PUBLIC_IP/auth/realms/domain-app
OIDC_CLIENT_ID=domain-knowledge-app
